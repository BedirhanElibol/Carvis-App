# ================================================
# CARVIS ENVIRONMENT VARIABLES
# ================================================
# Copy to .env and fill in values

# ================================================
# SUPABASE (Frontend - exposed to client)
# ================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# ================================================
# APP CONFIGURATION (Frontend)
# ================================================
VITE_APP_URL=http://localhost:5173
VITE_COMMISSION_RATE=0.05

# ================================================
# PAYTR CONFIGURATION
# ⚠️ SECURITY: These are SERVER-ONLY variables
# Do NOT use VITE_ prefix - they go in Supabase Edge Function secrets
# ================================================
# Set these in Supabase Dashboard > Edge Functions > Secrets:
# - PAYTR_MERCHANT_ID
# - PAYTR_MERCHANT_KEY (NEVER expose to client!)
# - PAYTR_MERCHANT_SALT (NEVER expose to client!)
# - PAYTR_TEST_MODE (1 = Test, 0 = Production)
# - APP_URL (for callback URLs)

# ================================================
# HOW TO SET EDGE FUNCTION SECRETS
# ================================================
# 1. Go to Supabase Dashboard
# 2. Navigate to Edge Functions
# 3. Click "Manage Secrets"
# 4. Add each secret:
#
#    PAYTR_MERCHANT_ID=your_merchant_id
#    PAYTR_MERCHANT_KEY=your_merchant_key
#    PAYTR_MERCHANT_SALT=your_merchant_salt
#    PAYTR_TEST_MODE=1
#    APP_URL=https://your-app-domain.com
